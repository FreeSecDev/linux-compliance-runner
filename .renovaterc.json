{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pre-commit",
    "terraform",
    "terraform-version",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenTofu release version and the SHA-256 of its linux/amd64 archive, pinned together in the Containerfile",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG OPENTOFU_VERSION=(?<currentValue>\\S+)\\nARG OPENTOFU_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "python-build-standalone release tag and the SHA-256 of its linux/amd64 musl CPython archive, pinned together in the Containerfile",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG PYTHON_BUILD_STANDALONE_RELEASE=(?<currentValue>\\d+)\\nARG PYTHON_BUILD_STANDALONE_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "astral-sh/python-build-standalone",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Renovate version used by make lint-renovate",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION := (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Python packages are owned by Dependabot; pre-commit Python tools run as local hooks through uv, so no PyPI dependency is managed here",
      "matchDatasources": [
        "pypi"
      ],
      "enabled": false
    },
    {
      "description": "The Python runtime version is changed only by a deliberate pull request with full testing",
      "matchDatasources": [
        "python-version"
      ],
      "enabled": false
    },
    {
      "description": "setup-python resolves Python versions through actions/python-versions; the runtime is changed only by a deliberate pull request",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "enabled": false
    },
    {
      "description": "Major updates wait longer and are labelled for review; nobody is asked to approve them on the dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "addLabels": [
        "breaking-change"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": [
        "terraform",
        "terraform-version"
      ],
      "addLabels": [
        "area/aws"
      ]
    },
    {
      "description": "Pinned binary downloads in the Containerfile",
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "area/runner"
      ],
      "groupName": "toolbox binaries"
    },
    {
      "description": "Container base image digests and tags in Containerfiles",
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "area/runner"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
