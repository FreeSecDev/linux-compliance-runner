{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pre-commit",
    "terraform",
    "terraform-version",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenTofu release version and the SHA-256 of its linux/amd64 archive, pinned together in the Containerfile",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG OPENTOFU_VERSION=(?<currentValue>\\S+)\\nARG OPENTOFU_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "python-build-standalone release tag and the SHA-256 of its linux/amd64 musl CPython archive, pinned together in the Containerfile",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "ARG PYTHON_BUILD_STANDALONE_RELEASE=(?<currentValue>\\d+)\\nARG PYTHON_BUILD_STANDALONE_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "astral-sh/python-build-standalone",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Grype release version and the SHA-256 of its linux/amd64 archive, pinned together in the Makefile for make image-scan",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "GRYPE_VERSION := (?<currentValue>\\S+)\\nGRYPE_SHA256_LINUX_AMD64 := (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "cosign release version and the SHA-256 of its linux/amd64 binary, pinned together in the Makefile to verify the Grype release signature",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "COSIGN_VERSION := (?<currentValue>\\S+)\\nCOSIGN_SHA256_LINUX_AMD64 := (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Syft release version and the SHA-256 of its linux/amd64 archive, pinned together in the Makefile for make sbom",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "SYFT_VERSION := (?<currentValue>\\S+)\\nSYFT_SHA256_LINUX_AMD64 := (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "go-containerregistry (crane) release version and the SHA-256 of its Linux x86_64 archive, pinned together in the Makefile for make image-promote",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "CRANE_VERSION := (?<currentValue>\\S+)\\nCRANE_SHA256_LINUX_AMD64 := (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "google/go-containerregistry",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Amazon ECR credential helper version in codebuild/build-image.sh; the release is on S3, so Renovate proposes the version and the pull request must also update ECR_LOGIN_SHA256 from the release .sha256 file (the build fails until it does)",
      "managerFilePatterns": [
        "/^codebuild/build-image\\.sh$/"
      ],
      "matchStrings": [
        "readonly ECR_LOGIN_VERSION='(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"
      ],
      "depNameTemplate": "awslabs/amazon-ecr-credential-helper",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Python packages are owned by Dependabot; pre-commit Python tools run as local hooks through uv, so no PyPI dependency is managed here",
      "matchDatasources": [
        "pypi"
      ],
      "enabled": false
    },
    {
      "description": "The Python runtime version is changed only by a deliberate pull request with full testing",
      "matchDatasources": [
        "python-version"
      ],
      "enabled": false
    },
    {
      "description": "setup-python resolves Python versions through actions/python-versions; the runtime is changed only by a deliberate pull request",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "enabled": false
    },
    {
      "description": "Major updates wait longer and are labelled for review; nobody is asked to approve them on the dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "addLabels": [
        "breaking-change"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": [
        "terraform",
        "terraform-version"
      ],
      "addLabels": [
        "area/aws"
      ]
    },
    {
      "description": "Pinned binary downloads in the Containerfile",
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "area/runner"
      ],
      "groupName": "toolbox binaries"
    },
    {
      "description": "The pinned Grype scanner used by make image-scan and the cosign that verifies its release signature; neither is shipped in the image",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "anchore/grype",
        "sigstore/cosign"
      ],
      "groupName": "image scanner"
    },
    {
      "description": "Container base image digests and tags in Containerfiles",
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "area/runner"
      ]
    },
    {
      "description": "The Renovate validator tree in tools/renovate (package.json and package-lock.json) used by make lint-renovate; it is not shipped in the image",
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "renovate validator"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "npm": {
    "managerFilePatterns": [
      "/^tools/renovate/package\\.json$/"
    ],
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": [
        "before 6am on monday"
      ]
    }
  }
}
